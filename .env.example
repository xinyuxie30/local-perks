# Reference only: Spring Boot does not automatically load this file.
# Set these environment variables in your terminal or IDE run configuration.
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_URL=jdbc:mysql://127.0.0.1:3306/hmdp?useSSL=false&serverTimezone=UTC
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# RocketMQ 事务消息与延迟关单依赖它，本地启动见 deploy/rocketmq/README.md
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# A：入口扣减库存并投递事务消息；B：入口只排队，库存由消费者认领
SECKILL_MODE=A
# 延迟关单的 RocketMQ 延迟级别，16=30 分钟，本地演示可改 3（10 秒）
TRADE_CLOSE_DELAY_LEVEL=16
# 与延迟级别对应的关单时长，供对账补关单使用
TRADE_CLOSE_DELAY_MINUTES=30
